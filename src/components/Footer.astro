---
import {
  FOOTER_LINKS,
  BRAND_NAME,
  BRAND_LOGO_TEXT,
  SITE_DESCRIPTION,
  SOCIAL_LINKS,
  SITE_URL,
  CONTACT_INFO,
} from '../config';
import { resolvePath } from '../utils/navigation';

const currentYear = new Date().getFullYear();

// Structured data (JSON-LD) para SEO local: ayuda a Google a entender
// quién eres, dónde estás y cómo contactarte. Aparece en resultados de
// búsqueda enriquecidos (Knowledge Panel, mapa, etc).
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  name: BRAND_NAME,
  url: SITE_URL,
  telephone: CONTACT_INFO.phoneE164,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${CONTACT_INFO.addressStreet}, ${CONTACT_INFO.addressExtra}`,
    addressLocality: CONTACT_INFO.city,
    addressRegion: CONTACT_INFO.region,
    addressCountry: CONTACT_INFO.country,
  },
  sameAs: Object.values(SOCIAL_LINKS).filter(Boolean),
};
---

<footer class="bg-white dark:bg-[#09090b] border-t border-slate-200 dark:border-slate-800 pt-16 pb-8 transition-colors">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <!-- h2 oculto: da jerarquía de encabezados correcta para SEO/accesibilidad -->
    <h2 class="sr-only">Pie de página</h2>

    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-[minmax(280px,1.1fr)_repeat(4,minmax(140px,1fr))] lg:gap-8 mb-12">
      <!-- Brand & Newsletter -->
      <div>
        <a href={resolvePath('/')} class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 bg-stone-800 dark:bg-primary-500 rounded-lg flex items-center justify-center">
            <span class="text-white font-bold text-xl leading-none">{BRAND_LOGO_TEXT}</span>
          </div>
          <span class="font-heading font-bold text-xl text-slate-900 dark:text-white">{BRAND_NAME}</span>
        </a>
        <p class="text-slate-600 dark:text-slate-400 text-sm mb-6">
          {SITE_DESCRIPTION}
        </p>
        <form class="flex w-full max-w-sm flex-col gap-2 sm:flex-row md:flex-col lg:flex-row">
          <label for="footer-newsletter-email" class="sr-only">Correo electrónico</label>
          <input
            id="footer-newsletter-email"
            type="email"
            name="email"
            placeholder="Introduce tu correo"
            autocomplete="email"
            class="min-w-0 flex-1 px-3 py-2.5 border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white placeholder:text-slate-400 rounded-lg text-sm leading-5 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
            required
          />
          <button type="submit" class="shrink-0 px-4 py-2.5 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-lg text-sm font-medium leading-5 hover:bg-slate-800 dark:hover:bg-slate-100 transition-colors">
            Suscríbete
          </button>
        </form>
      </div>

      <!-- Links: ahora en 4 columnas reales (Navegación, Servicios, Recursos, Legal) -->
      <nav aria-label="Enlaces del pie de página" class="lg:col-span-3 grid grid-cols-2 sm:grid-cols-4 gap-8">
        {FOOTER_LINKS.map(group => (
          <div>
            <h3 class="font-semibold text-slate-900 dark:text-white mb-4">{group.title}</h3>
            <ul class="space-y-3">
              {group.links.map(link => (
                <li>
                  <a href={resolvePath(link.href)} class="text-sm text-slate-600 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>

      <!-- Contacto: <address> semántico, mejor para SEO local que un <div> -->
      <address class="w-full not-italic">
        <h3 class="font-semibold text-slate-900 dark:text-white mb-4">Contáctanos</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400">
          {CONTACT_INFO.addressStreet}, {CONTACT_INFO.addressExtra}
        </p>
        <ul class="mt-4 space-y-2 text-sm text-slate-600 dark:text-slate-400">
          <li>{CONTACT_INFO.city}, Ecuador</li>
          <li>
            <a href={`tel:${CONTACT_INFO.phoneE164}`} class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
              {CONTACT_INFO.phoneDisplay}
            </a>
          </li>
          <li>
            <a href={CONTACT_INFO.website} target="_blank" rel="noopener noreferrer" class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
              {CONTACT_INFO.website.replace('https://', '')}
            </a>
          </li>
        </ul>
      </address>
    </div>

    <div class="border-t border-slate-200 dark:border-slate-800 pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-sm text-slate-500 dark:text-slate-400">
        &copy; {currentYear} {BRAND_NAME}. Todos los derechos reservados.
      </p>

      <!-- Social Icons -->
      <div class="flex gap-4 text-slate-400 dark:text-slate-500">
        <a href={SOCIAL_LINKS.twitter} class="hover:text-slate-600 dark:hover:text-slate-300" target="_blank" rel="noopener noreferrer">
          <span class="sr-only">Twitter</span>
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84" /></svg>
        </a>
        <a href={SOCIAL_LINKS.github} class="hover:text-slate-600 dark:hover:text-slate-300" target="_blank" rel="noopener noreferrer">
          <span class="sr-only">GitHub</span>
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
        </a>
        <a href={SOCIAL_LINKS.linkedin} class="hover:text-slate-600 dark:hover:text-slate-300" target="_blank" rel="noopener noreferrer">
          <span class="sr-only">LinkedIn</span>
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
        </a>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</footer>