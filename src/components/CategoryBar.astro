---
import { LISTING_CATEGORIES } from "../lib/listingCategories";

const activeCategory = Astro.url.searchParams.get("category") ?? "";

// Íconos de línea propios (no emoji) con un color de acento por categoría,
// mismo estilo que el resto del sitio.
const ICONS: Record<string, string> = {
  todo: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3Z"/></svg>`,
  medico: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4v6a5 5 0 0 0 10 0V4"/><path d="M5 4H3.5M15 4h1.5"/><circle cx="19" cy="15" r="2.5"/><path d="M10 10v3a6 6 0 0 0 6.6 5.97"/></svg>`,
  dental: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c-2.2 0-3.5 1.3-4.5 1.3C6.2 4.3 5 5.8 5 8.2c0 2.7.9 4.9 1.6 7.1.5 1.6.9 3.4 1.9 3.4.9 0 1-1.6 1.3-3 .3-1.4.7-2.5 2.2-2.5s1.9 1.1 2.2 2.5c.3 1.4.4 3 1.3 3 1 0 1.4-1.8 1.9-3.4.7-2.2 1.6-4.4 1.6-7.1 0-2.4-1.2-3.9-2.5-3.9C15.5 4.3 14.2 3 12 3Z"/></svg>`,
  fisioterapia: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="13" cy="4" r="1.6"/><path d="M6 20l3-5 2.5-2-1-4 4-2.5 3 3.5-3 2 1.5 3.5L19 18"/><path d="M6.5 12.5 9.5 11"/></svg>`,
  psicologia: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 3c-2.5 0-4 2-4 4 0 .8.2 1.4.5 2-1.3.6-2 1.9-2 3.4 0 1.4.8 2.6 2 3.2-.1.4-.2.8-.2 1.3 0 2 1.6 3.6 3.6 3.6.5 0 1-.1 1.4-.3"/><path d="M14.5 3c2.5 0 4 2 4 4 0 .8-.2 1.4-.5 2 1.3.6 2 1.9 2 3.4 0 1.4-.8 2.6-2 3.2.1.4.2.8.2 1.3 0 2-1.6 3.6-3.6 3.6-.9 0-1.7-.3-2.3-.9M12 3v17.5"/></svg>`,
  otro: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="1.5"/><path d="M9 8h1M14 8h1M9 12h1M14 12h1M9 16h6"/></svg>`,
};

const COLORS: Record<string, string> = {
  todo: "text-neutral-700 dark:text-neutral-300",
  medico: "text-sky-500",
  dental: "text-cyan-500",
  fisioterapia: "text-emerald-500",
  psicologia: "text-violet-500",
  otro: "text-amber-500",
};

const items = [
  { value: "", label: "Todo", iconKey: "todo" },
  ...LISTING_CATEGORIES.map((c) => ({ value: c.value, label: c.label, iconKey: c.value })),
];
---

<div class="mt-16 border-b border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-950">
  <nav
    class="max-w-[1600px] mx-auto px-4 sm:px-6 flex items-center justify-center gap-8 overflow-x-auto no-scrollbar"
    aria-label="Categorías de espacios médicos"
  >
    {items.map((item) => {
      const isActive = activeCategory === item.value;
      const href = item.value ? `/listings/?category=${item.value}` : "/listings/";
      return (
        <a
          href={href}
          class={`shrink-0 flex flex-col items-center gap-1.5 py-3 border-b-2 text-xs font-medium transition-all ${
            isActive
              ? "border-neutral-900 dark:border-white text-neutral-900 dark:text-white"
              : "border-transparent text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white hover:border-neutral-300 dark:hover:border-neutral-600"
          }`}
        >
          <span
            class={`w-6 h-6 transition-transform group-hover:scale-110 ${isActive ? COLORS[item.iconKey] : "text-current opacity-70"} ${item.iconKey === "todo" ? "animate-[spin-slow_6s_linear_infinite]" : ""}`}
            set:html={ICONS[item.iconKey]}
          />
          {item.label}
        </a>
      );
    })}
  </nav>
</div>

<style>
  .no-scrollbar {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>
